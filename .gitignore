# ================================
# 1. Xcode 个人数据与用户界面状态
# ================================
# 每个开发者的本地设置，绝对不应共享
xcuserdata/
*.xcuserstate
*.mode1v3
*.mode2v3
*.xccheckout
*.moved-aside
*.pbxuser
!default.pbxuser

# ================================
# 2. Xcode 编译缓存与构建产物
# ================================
DerivedData/
build/
.assets-data/
*.appex/
*.xcresult/
*.hmap
*.ipa
*.dSYM.zip
*.dSYM/
*.xcarchive
*.xcapp

# ================================
# 3. SwiftUI & Playground 临时文件
# ================================
*.preview/
.playground/

# ================================
# 4. 系统与编辑器临时文件
# ================================
.DS_Store
.AppleDouble
.LSOverride
*.swp
*~
.nfs*
.idea/
.vscode/
*.sublime-*

# ================================
# 5. 敏感信息与密钥（安全最佳实践）
# ================================
*.env
*.secret
*.key
*.pem
*.plist.secret

# ================================
# 6. Swift Package Manager (SPM)
# ================================
.build/
Packages/
.swiftpm/
!/.swiftpm/configuration/Package.resolved
!/**/Package.resolved

# ================================
# 7. 其他依赖管理器
# ================================
# CocoaPods
Pods/
.cocoapods/
!**/Podfile.lock

# Carthage
Carthage/Build/
Carthage/Checkouts/

# ================================
# 8. 自动化运维与日志 (可选)
# ================================
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/
fastlane/test_output/
*.log
